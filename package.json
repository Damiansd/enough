{
  "name": "enough",
  "version": "0.0.0",
  "description": "A personal retirement and cashflow forecaster for an Australian couple",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && cp -R public/. dist/ && node scripts/build-guide.mjs",
    "watch": "tsc --watch",
    "test": "npm run build && node --test test/",
    "start": "npm run build && node server/start.mjs",
    "serve": "node server/index.mjs",
    "update-assumptions": "npm run build && node scripts/update-assumptions.mjs",
    "golden:update": "npm run build && node scripts/golden-update.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
